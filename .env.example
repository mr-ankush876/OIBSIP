# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/pizzadb

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_1234567890
JWT_EXPIRES_IN=7d
COOKIE_SECRET=pizza_cookie_secret_key_1234567890

# Razorpay Test Mode Payment Gateway
# Obtain test credentials from Razorpay Dashboard (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Nodemailer / Email Delivery
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user@ethereal.email
SMTP_PASS=your_smtp_password
EMAIL_FROM="SliceCraft Pizza" <no-reply@slicecraftpizza.com>
ADMIN_ALERT_EMAIL=admin@slicecraftpizza.com

# Initial Administrator Bootstrap Credentials
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@pizzadelivery.com
INITIAL_ADMIN_PASSWORD=AdminSecure@12345

# WhatsApp Customer Support (International Format: country code without + or spaces)
WHATSAPP_SUPPORT_PHONE=919876543210
WHATSAPP_DEFAULT_MESSAGE=Hello! I need help with my pizza order on SliceCraft.

# Inventory Monitoring & Scheduled Tasks (node-cron)
LOW_STOCK_CRON_SCHEDULE="0 * * * *"
DEFAULT_LOW_STOCK_THRESHOLD=20
